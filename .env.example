# Mubert Music API v3 credentials
# Get your credentials at https://mubert.com/api

# Service-level (for mubert-manage: licenses, customers, webhooks)
MUBERT_COMPANY_ID=your-company-id
MUBERT_LICENSE_TOKEN=your-license-token

# Customer-level (for mubert-generate and mubert-streaming)
# Obtain these by creating a customer via the mubert-manage skill or service API
# Single-user setups only — in a multi-user app these are minted per user at
# runtime by mubert_provisioning.py and must NOT be shared across users.
MUBERT_CUSTOMER_ID=your-customer-id
MUBERT_ACCESS_TOKEN=your-access-token

# Multi-user only: scopes per-user custom_ids to this app AND environment.
# custom_id is unique per company and creation is find-or-create, so two
# deployments sharing a namespace share one customer and one usage counter.
# Use distinct values for staging and production.
MUBERT_NAMESPACE=myapp-prod
