# Mubert Music API v3 credentials
# Get your credentials at https://mubert.com/api

# Service-level (for mubert-manage: licenses, customers, webhooks)
MUBERT_COMPANY_ID=your-company-id
MUBERT_LICENSE_TOKEN=your-license-token

# Customer-level (for mubert-generate and mubert-streaming)
# Obtain these by creating a customer via the mubert-manage skill or service API
MUBERT_CUSTOMER_ID=your-customer-id
MUBERT_ACCESS_TOKEN=your-access-token
